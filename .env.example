# Kakao Maps REST key stays on the development server. Never use a VITE_ prefix for it.
KAKAO_REST_API_KEY=KAKAO_REST_API_KEY_PLACEHOLDER

# Optional map display. This JavaScript key is visible to browser users.
# Register http://localhost:5173 in the Kakao JavaScript SDK allowed domains.
VITE_KAKAO_MAP_JS_KEY=KAKAO_JAVASCRIPT_KEY_PLACEHOLDER

# Optional elevator movement guidance from KRIC.
KRIC_API_KEY=API_KEY_PLACEHOLDER

# Seoul Open Data Plaza: SeoulMetroFaciInfo (elevator location and operating status).
# Server-side only. Never put this in a VITE_ variable.
SEOUL_API_KEY=SEOUL_API_KEY_PLACEHOLDER
